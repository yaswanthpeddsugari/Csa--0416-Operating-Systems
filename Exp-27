#include <stdio.h>
#include <dirent.h>

int main()
{
    DIR *d;
    struct dirent *entry;

    d=opendir(".");

    if(d==NULL)
    {
        printf("Cannot open directory");
        return 1;
    }

    printf("Files in Directory:\n");

    while((entry=readdir(d))!=NULL)
        printf("%s\n",entry->d_name);

    closedir(d);

    return 0;
}
