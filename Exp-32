#include <stdio.h>

int main()
{
    int p[30],f[10],time[10];
    int n,m,i,j,t=0,hit,fault=0,pos;

    printf("Enter number of pages: ");
    scanf("%d",&n);

    printf("Enter page reference string:\n");
    for(i=0;i<n;i++)
        scanf("%d",&p[i]);

    printf("Enter number of frames: ");
    scanf("%d",&m);

    for(i=0;i<m;i++)
        f[i]=-1,time[i]=0;

    for(i=0;i<n;i++)
    {
        hit=0;
        pos=0;

        for(j=0;j<m;j++)
        {
            if(f[j]==p[i])
            {
                hit=1;
                pos=j;
                break;
            }
        }

        if(!hit)
        {
            for(j=0;j<m;j++)
                if(f[j]==-1)
                {
                    pos=j;
                    break;
                }

            if(j==m)
                for(j=1;j<m;j++)
                    if(time[j]<time[pos])
                        pos=j;

            f[pos]=p[i];
            fault++;
        }

        time[pos]=++t;

        for(j=0;j<m;j++)
            printf("%d ",f[j]);

        printf("\n");
    }

    printf("Page Faults = %d\n",fault);

    return 0;
}
