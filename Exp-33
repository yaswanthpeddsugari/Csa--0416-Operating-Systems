#include <stdio.h>

int main()
{
    int p[30],f[10],n,m,i,j,k,pos;
    int fault=0,found,future,far;

    printf("Enter number of pages: ");
    scanf("%d",&n);

    printf("Enter page reference string:\n");
    for(i=0;i<n;i++)
        scanf("%d",&p[i]);

    printf("Enter number of frames: ");
    scanf("%d",&m);

    for(i=0;i<m;i++)
        f[i]=-1;

    for(i=0;i<n;i++)
    {
        found=0;

        for(j=0;j<m;j++)
            if(f[j]==p[i])
                found=1;

        if(!found)
        {
            pos=-1;
            far=-1;

            for(j=0;j<m;j++)
            {
                if(f[j]==-1)
                {
                    pos=j;
                    break;
                }

                future=n;

                for(k=i+1;k<n;k++)
                    if(f[j]==p[k])
                    {
                        future=k;
                        break;
                    }

                if(future>far)
                {
                    far=future;
                    pos=j;
                }
            }

            f[pos]=p[i];
            fault++;
        }

        for(j=0;j<m;j++)
            printf("%d ",f[j]);

        printf("\n");
    }

    printf("Page Faults = %d\n",fault);

    return 0;
}
