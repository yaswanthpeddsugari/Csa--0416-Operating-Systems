
#include <stdio.h>

void firstFit(int block[], int m, int process[], int n) {
    int allocation[20], b[20], i, j;

    for (i = 0; i < m; i++)
        b[i] = block[i];

    for (i = 0; i < n; i++)
        allocation[i] = -1;

    for (i = 0; i < n; i++) {
        for (j = 0; j < m; j++) {
            if (b[j] >= process[i]) {
                allocation[i] = j;
                b[j] -= process[i];
                break;
            }
        }
    }

    printf("\nFirst Fit Allocation:\n");
    printf("Process\tSize\tBlock\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t", i + 1, process[i]);
        if (allocation[i] != -1)
            printf("%d\n", allocation[i] + 1);
        else
            printf("Not Allocated\n");
    }
}

void bestFit(int block[], int m, int process[], int n) {
    int allocation[20], b[20], i, j, best;

    for (i = 0; i < m; i++)
        b[i] = block[i];

    for (i = 0; i < n; i++)
        allocation[i] = -1;

    for (i = 0; i < n; i++) {
        best = -1;
        for (j = 0; j < m; j++) {
            if (b[j] >= process[i]) {
                if (best == -1 || b[j] < b[best])
                    best = j;
            }
        }

        if (best != -1) {
            allocation[i] = best;
            b[best] -= process[i];
        }
    }

    printf("\nBest Fit Allocation:\n");
    printf("Process\tSize\tBlock\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t", i + 1, process[i]);
        if (allocation[i] != -1)
            printf("%d\n", allocation[i] + 1);
        else
            printf("Not Allocated\n");
    }
}

void worstFit(int block[], int m, int process[], int n) {
    int allocation[20], b[20], i, j, worst;

    for (i = 0; i < m; i++)
        b[i] = block[i];

    for (i = 0; i < n; i++)
        allocation[i] = -1;

    for (i = 0; i < n; i++) {
        worst = -1;
        for (j = 0; j < m; j++) {
            if (b[j] >= process[i]) {
                if (worst == -1 || b[j] > b[worst])
                    worst = j;
            }
        }

        if (worst != -1) {
            allocation[i] = worst;
            b[worst] -= process[i];
        }
    }

    printf("\nWorst Fit Allocation:\n");
    printf("Process\tSize\tBlock\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t", i + 1, process[i]);
        if (allocation[i] != -1)
            printf("%d\n", allocation[i] + 1);
        else
            printf("Not Allocated\n");
    }
}

int main() {
    int block[20], process[20];
    int m, n, i;

    printf("Enter number of memory blocks: ");
    scanf("%d", &m);

    printf("Enter sizes of memory blocks:\n");
    for (i = 0; i < m; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter sizes of processes:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &process[i]);

    firstFit(block, m, process, n);
    bestFit(block, m, process, n);
    worstFit(block, m, process, n);

    return 0;
}
