#include <stdio.h>

int main()
{
    FILE *fp;
    char data[100];

    fp=fopen("file.txt","w");
    fprintf(fp,"Hello File Management");
    fclose(fp);

    fp=fopen("file.txt","r");
    fgets(data,100,fp);
    printf("Content: %s\n",data);
    fclose(fp);

    fp=fopen("file.txt","a");
    fprintf(fp,"\nNew Data Added");
    fclose(fp);

    rename("file.txt","newfile.txt");

    printf("File renamed successfully\n");

    remove("newfile.txt");

    printf("File deleted successfully\n");

    return 0;
}
