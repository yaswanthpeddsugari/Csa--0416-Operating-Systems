#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char line[200],word[50];

    fp=fopen("server.log","r");

    if(fp==NULL)
    {
        printf("File not found");
        return 1;
    }

    printf("Enter search word: ");
    scanf("%49s",word);

    while(fgets(line,sizeof(line),fp))
    {
        if(strstr(line,word)!=NULL)
            printf("%s",line);
    }

    fclose(fp);

    return 0;
}
